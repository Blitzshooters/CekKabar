# =============================================================
# CekKabar – Root .gitignore
# =============================================================

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---- Editor ----
.idea/
.vscode/
*.swp
*.swo

# =============================================================
# MODELLING (Python)
# =============================================================
modelling/__pycache__/
modelling/*.pyc
modelling/venv/
modelling/.env

# =============================================================
# DOCS
# =============================================================
# Excel file is binary and regenerated by generate_excel.py
# Comment out next line if you want to track the .xlsx
docs/*.xlsx

# =============================================================
# BACKEND (Laravel)
# =============================================================
backend/.env                    # NEVER commit credentials!
backend/vendor/
backend/node_modules/
backend/storage/logs/*.log
backend/storage/app/public/
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/bootstrap/cache/*.php
backend/public/hot
backend/public/storage
backend/.phpunit.result.cache
backend/coverage/

# =============================================================
# FRONTEND (Android / Kotlin)
# =============================================================
frontend/.gradle/
frontend/app/build/
frontend/build/
frontend/local.properties         # Contains SDK path (machine-specific)
frontend/**/*.jks                 # Keystore files – keep private!
frontend/**/*.keystore
frontend/app/google-services.json
frontend/.idea/
frontend/**/*.iml
frontend/captures/
frontend/.externalNativeBuild/
frontend/.cxx/

